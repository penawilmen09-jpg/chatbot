{
  "name": "WILMEN AI",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "postCreateCommand": "corepack enable && pnpm install --frozen-lockfile",
  "postAttachCommand": "pnpm dev -H 0.0.0.0 -p 3000",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "WILMEN AI",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
