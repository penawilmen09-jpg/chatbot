; Engine configuration file.
; WILMEN ADVENTURE - Godot 4.3 (GDScript)

config_version=5

[application]

config/name="WILMEN ADVENTURE"
config/description="Juego de plataformas 2D de 16 bits: 20 niveles, 5 mundos y 5 jefes. Sin conexión, sin anuncios."
run/main_scene="res://ui/title.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0.07, 0.04, 0.12, 1)
config/icon="res://icon.png"
config/quit_on_go_back=false

[autoload]

Game="*res://autoload/game.gd"
Audio="*res://autoload/audio.gd"
Transition="*res://autoload/transition.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[layer_names]

2d_physics/layer_1="mundo"
2d_physics/layer_2="jugador"
2d_physics/layer_3="enemigos"

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.04, 0.12, 1)
2d/snap/snap_2d_transforms_to_pixel=true
